    {
      "name": "3. Validation and error format",
      "item": [
        {
          "name": "Missing Idempotency-Key -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlation_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/payments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "payments"
              ]
            },
            "description": "",
