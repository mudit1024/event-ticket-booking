            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"status FAILED with a reason\", () => { const b = pm.response.json(); pm.expect(b.status).to.eql(\"FAILED\"); pm.expect(b.failure_reason).to.include(\"CARD_DECLINED\"); });"
                ]
              }
            }
