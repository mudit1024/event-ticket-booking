{
  "info": {
    "name": "Event Ticket Booking - Payment Mock",
    "description": "Manual and Collection Runner checks for services/payment-mock. Set base_url to the port the service runs on (8084 by default). Run the folders in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8084"
    },
    {
      "key": "correlation_id",
      "value": "postman-demo-1"
    },
    {
      "key": "booking_id",
      "value": ""
    },
    {
      "key": "idem_key",
      "value": ""
    },
    {
      "key": "payment_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlation_id}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness plus a SELECT 1 against payment_db. Also shows the X-Correlation-Id header being echoed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"service and database UP\", () => { const b = pm.response.json(); pm.expect(b.status).to.eql(\"UP\"); pm.expect(b.database).to.eql(\"UP\"); });",
                  "pm.test(\"correlation id echoed\", () => pm.expect(pm.response.headers.get(\"X-Correlation-Id\")).to.eql(pm.collectionVariables.get(\"correlation_id\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Simulation: get",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlation_id}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/simulation",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "simulation"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Simulation: set SUCCESS",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlation_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/simulation",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "simulation"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"SUCCESS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"mode is SUCCESS\", () => pm.expect(pm.response.json().mode).to.eql(\"SUCCESS\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Idempotency (Challenge 2, BR7-BR9)",
      "item": [
        {
          "name": "1. New payment (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlation_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idem_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/payments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "payments"
              ]
            },
            "description": "Generates a fresh booking_id and Idempotency-Key, then charges once.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_id\": \"{{booking_id}}\",\n  \"amount\": 1500.00,\n  \"currency\": \"INR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"booking_id\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"idem_key\", \"pay-\" + pm.collectionVariables.get(\"booking_id\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"not a replay\", () => pm.expect(pm.response.headers.get(\"Idempotent-Replay\")).to.eql(\"false\"));",
                  "pm.test(\"SUCCEEDED\", () => pm.expect(pm.response.json().status).to.eql(\"SUCCEEDED\"));",
                  "pm.collectionVariables.set(\"payment_id\", pm.response.json().payment_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Same key + same payload -> replay (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlation_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idem_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/payments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "payments"
              ]
            },
            "description": "BR7: no second charge; the stored response is returned.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_id\": \"{{booking_id}}\",\n  \"amount\": 1500.00,\n  \"currency\": \"INR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Idempotent-Replay: true\", () => pm.expect(pm.response.headers.get(\"Idempotent-Replay\")).to.eql(\"true\"));",
                  "pm.test(\"same payment_id as first call\", () => pm.expect(pm.response.json().payment_id).to.eql(pm.collectionVariables.get(\"payment_id\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Same key + different payload -> 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlation_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idem_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/payments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "payments"
              ]
            },
            "description": "BR8: the request fingerprint (SHA-256 of booking_id|amount|currency) does not match.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_id\": \"{{booking_id}}\",\n  \"amount\": 9999.00,\n  \"currency\": \"INR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"error code IDEMPOTENCY_KEY_REUSED\", () => pm.expect(pm.response.json().code).to.eql(\"IDEMPOTENCY_KEY_REUSED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. New key for already-paid booking -> 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlation_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "other-{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/payments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "payments"
              ]
            },
            "description": "BR9: partial unique index allows only one PROCESSING/SUCCEEDED payment per booking.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_id\": \"{{booking_id}}\",\n  \"amount\": 1500.00,\n  \"currency\": \"INR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"error code BOOKING_ALREADY_PAID\", () => pm.expect(pm.response.json().code).to.eql(\"BOOKING_ALREADY_PAID\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Get payment by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlation_id}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/payments/{{payment_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "{{payment_id}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"matches created payment\", () => pm.expect(pm.response.json().payment_id).to.eql(pm.collectionVariables.get(\"payment_id\")));"
                ]
              }
            }
          ]
        }
      ]
    },
